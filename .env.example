# Vault directory (absolute path) — watched and indexed.
DOCINDEX_VAULT_DIR=/var/lib/docindex/vault

# SQLite DB path
DOCINDEX_DB_PATH=/var/lib/docindex/index.db

# Listen address (Tailscale interface only — do NOT use 0.0.0.0)
DOCINDEX_LISTEN=100.64.0.1:7777

# Dev/test ONLY: allow 127.0.0.1 / ::1 binds. Leave unset/false in prod.
# DOCINDEX_ALLOW_LOOPBACK=false

# Bearer token (required)
DOCINDEX_BEARER=changeme

# Embedder backend: "gemini", "voyage", or "fake" (deterministic, for tests).
# Defaults to "gemini" if GEMINI_API_KEY is set, else "voyage" if
# VOYAGE_API_KEY is set, else "fake".
# DOCINDEX_EMBED=gemini

# Gemini (default stable model: gemini-embedding-2)
GEMINI_API_KEY=
DOCINDEX_EMBED_MODEL=gemini-embedding-2
# Gemini Embedding 2 supports text, images, and PDFs; it is natively 3072 and
# supports Matryoshka truncation to 768 or 1536. Switching an existing 001 DB
# to this model requires starting once with --reembed; vector spaces never mix.
# Paid provider rates are account-specific; consult the provider's pricing.
DOCINDEX_EMBED_DIM=3072

# Voyage AI (alternative to Gemini): DOCINDEX_EMBED=voyage.
# voyage-4 and relatives remain text-only. For images/PDFs use
# voyage-multimodal-3.5 with a 256/512/1024/2048 dim (native 1024).
# VOYAGE_API_KEY=

# Media indexing is configured in [media] in server.toml, not environment vars.
# Enable it only with gemini-embedding-2, voyage-multimodal-3.5, or fake.
# Images (png/jpg/jpeg/webp/gif) and PDFs are indexed; audio/video are reserved
# exclusion labels only and are not indexed. PDF default is one page/chunk for
# Gemini quality and to avoid silent context truncation. Changing media profile
# reindexes affected media; changing provider/model/dim requires --reembed.

# Watcher debounce for fsnotify-like events
DOCINDEX_DEBOUNCE_MS=5000

# HTTP client timeout (Gemini etc.)
DOCINDEX_HTTP_TIMEOUT_MS=30000

# Log format: json (prod) or text (dev)
DOCINDEX_LOG_FORMAT=json

# Display + threshold tuning (ranking is always RRF k=60; these only affect
# the 0..1 score_normalized field the plugin uses for "% relevance" and the
# relevance-threshold filter).
#
# Smaller display_k → steeper falloff past rank-1. Default 10 gives
# rank-1→1.0, rank-10→~0.55, rank-20→~0.37.
# DOCINDEX_DISPLAY_K=10
#
# Weights for the semantic vs. BM25 branches. Must sum to 1.0 (± 0.01). If
# only DOCINDEX_WEIGHT_VEC is set, BM25 is derived as (1 - vec).
# DOCINDEX_WEIGHT_VEC=0.55
# DOCINDEX_WEIGHT_BM25=0.45
