# Vault directory (absolute path) — watched and indexed.
DOCINDEX_VAULT_DIR=/var/lib/docindex/vault

# SQLite DB path
DOCINDEX_DB_PATH=/var/lib/docindex/index.db

# Listen address (Tailscale interface only — do NOT use 0.0.0.0)
DOCINDEX_LISTEN=100.83.46.59:7777

# Dev/test ONLY: allow 127.0.0.1 / ::1 binds. Leave unset/false in prod.
# DOCINDEX_ALLOW_LOOPBACK=false

# Bearer token (required)
DOCINDEX_BEARER=changeme

# Embedder backend: "gemini" (real API) or "fake" (deterministic, for tests).
# Defaults to "gemini" when GEMINI_API_KEY is set, otherwise "fake".
# DOCINDEX_EMBED=gemini

# Gemini
GEMINI_API_KEY=
DOCINDEX_EMBED_MODEL=gemini-embedding-001
# Embedding dimension. gemini-embedding-001 is natively 3072 and supports
# Matryoshka truncation to smaller dims (e.g. 768) — smaller = less disk +
# faster ANN, larger = a bit more recall. 3072 is the native quality point.
# Changing this on an existing DB requires wiping index.db — see
# docs/deployment.md ("Changing the embedding dim").
DOCINDEX_EMBED_DIM=3072

# Watcher debounce for fsnotify-like events
DOCINDEX_DEBOUNCE_MS=5000

# HTTP client timeout (Gemini etc.)
DOCINDEX_HTTP_TIMEOUT_MS=30000

# Log format: json (prod) or text (dev)
DOCINDEX_LOG_FORMAT=json
