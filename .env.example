# Vault directory (absolute path) — watched and indexed.
DOCINDEX_VAULT_DIR=/var/lib/docindex/vault

# SQLite DB path
DOCINDEX_DB_PATH=/var/lib/docindex/index.db

# Listen address (Tailscale interface only — do NOT use 0.0.0.0)
DOCINDEX_LISTEN=100.83.46.59:7777

# Bearer token (required)
DOCINDEX_BEARER=changeme

# Gemini
GEMINI_API_KEY=
DOCINDEX_EMBED_MODEL=gemini-embedding-001
DOCINDEX_EMBED_DIM=768

# Watcher (Phase 2) — debounce for fsnotify-like events
DOCINDEX_DEBOUNCE_MS=5000

# HTTP client timeout (Gemini etc.)
DOCINDEX_HTTP_TIMEOUT_MS=30000

# Log format: json (prod) or text (dev)
DOCINDEX_LOG_FORMAT=json
